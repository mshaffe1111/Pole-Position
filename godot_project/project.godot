[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false
sensors/enable_accelerometer=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=false

[layer_names]

3d_physics/layer_1="track_asphalt"
3d_physics/layer_2="track_curbs"
3d_physics/layer_3="track_runoff_grass_gravel"
3d_physics/layer_4="track_barriers"
3d_physics/layer_5="f1_vehicles"
3d_physics/layer_6="carbon_debris"
3d_physics/layer_7="slipstream_draft_zones"
3d_physics/layer_8="pit_lane_triggers"

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
common/enable_object_picking=false
3d/physics_engine="JoltPhysics3D"
3d/default_gravity=9.80665
3d/default_linear_damp=0.01
3d/default_angular_damp=0.02
3d/solver/solver_iterations=16

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=2048
environment/ssao/quality=2
environment/glow/upscale_mode=1
textures/default_filters/anisotropic_filtering_level=4

[shader_globals]

global_wetness={
"type": "float",
"value": 0.0
}
groove_wetness={
"type": "float",
"value": 0.0
}
wind_direction={
"type": "vec2",
"value": Vector2(0.85, 0.52)
}
wind_speed={
"type": "float",
"value": 3.6
}
crowd_excitement={
"type": "float",
"value": 0.75
}
camera_flash_rate={
"type": "float",
"value": 0.85
}
