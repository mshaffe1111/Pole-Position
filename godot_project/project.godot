; Engine configuration file.
; Race Phanatic F1 — Pole Position 2026: Retro Grand Prix (Godot 4.3 AAA Mobile & Desktop Pipeline)

config_version=5

[application]

config/name="Race Phanatic F1 — Pole Position 2026"
config/description="AAA Mobile & Console Formula 1 Grand Prix Simulation with 240Hz Pacejka/Aero Physics, 4-Camera Cockpit Rig, Blender Procedural Assets & Dynamic Weather"
config/version="2.1.0"
run/main_scene="res://scenes/main_race_weekend.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "Mobile")
run/max_fps=120

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=1

